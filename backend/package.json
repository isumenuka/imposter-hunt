{
    "name": "imposter-game-server",
    "version": "1.0.0",
    "description": "WebSocket-based multiplayer server for Imposter Guess Word game",
    "main": "server.js",
    "type": "module",
    "scripts": {
        "build": "node ../scripts/buildGameContent.cjs",
        "postinstall": "npm run build",
        "start": "node server.js",
        "dev": "node --watch server.js",
        "test": "node --test"
    },
    "keywords": [
        "websocket",
        "multiplayer",
        "socket.io",
        "game"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "express": "^4.18.2",
        "socket.io": "^4.7.2",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "openai": "^4.52.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}